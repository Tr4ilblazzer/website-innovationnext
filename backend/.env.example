# ── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/innovation_next?schema=public"

# ── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=hello@innovationnext.com
CAREERS_EMAIL=hr@innovationnext.com

# ── MinIO (CV uploads — shared with HRMS) ─────────────────────────
MINIO_ENDPOINT=fileapi.innovationnxt.com
MINIO_PORT=443
MINIO_USESSL=true
MINIO_ACCESSKEY=your_minio_access_key
MINIO_SECRETKEY=your_minio_secret_key
MINIO_BUCKET_NAME=hrmsbackend
MINIO_REGION=us-east-1

# ── JWT (for future admin routes) ───────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
